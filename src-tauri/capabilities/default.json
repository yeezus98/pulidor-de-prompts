{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal: solo lo que la app usa",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "updater:default",
    "process:allow-restart",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text"
  ]
}
